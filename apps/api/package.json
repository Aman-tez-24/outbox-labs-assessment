{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "start:worker": "dotenv -e ../../.env -- node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@bull-board/ui": "^9.8.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/client": "^6.19.0",
    "@slack/web-api": "^8.1.1",
    "bullmq": "^6.3.4",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.11",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
